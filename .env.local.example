# ── SMTP Configuration ───────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your credentials.
# .env.local is git-ignored — never commit real credentials.

# Gmail (App Password) ── most common setup
# 1. Go to myaccount.google.com → Security → 2-Step Verification → App passwords
# 2. Generate a password for "Mail" and paste it as SMTP_PASS below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# ── Alternative: Custom / Business SMTP (Zoho, Outlook, etc.) ────────────────
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=info@imperialtechinnovations.com
# SMTP_PASS=your-password-here
